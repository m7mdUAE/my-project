<?xml version="1.0" encoding="utf-8"?>
<configuration>

	<appSettings>
		<!-- Local preview mode -->
		<add key="LocalPreviewOnly" value="true" />
	</appSettings>

	<connectionStrings>
		<add name="PlateBookingDB"
			 connectionString="Data Source=.;Initial Catalog=PlateBookingDB;Integrated Security=True;Encrypt=True;TrustServerCertificate=True;"
			 providerName="System.Data.SqlClient" />
	</connectionStrings>

	<system.web>

		<compilation debug="true" targetFramework="4.7.2" />

		<httpRuntime
			targetFramework="4.7.2"
			maxRequestLength="15360"
			executionTimeout="120" />

		<pages
			controlRenderingCompatibilityVersion="4.0"
			clientIDMode="Static" />

		<!-- Arabic and UTF-8 encoding -->
		<globalization
			requestEncoding="utf-8"
			responseEncoding="utf-8"
			fileEncoding="utf-8"
			culture="ar-AE"
			uiCulture="ar-AE" />

		<!-- Local preview authentication -->
		<authentication mode="None" />

		<sessionState
			mode="InProc"
			timeout="20"
			cookieless="UseCookies" />

		<customErrors mode="Off" />

		<httpCookies
			httpOnlyCookies="true"
			requireSSL="false" />

	</system.web>

	<system.webServer>

		<security>
			<requestFiltering>
				<requestLimits maxAllowedContentLength="15728640" />
			</requestFiltering>
		</security>

		<defaultDocument>
			<files>
				<add value="PlateBooking.aspx" />
			</files>
		</defaultDocument>

	</system.webServer>

	<!-- Resolve System.Numerics.Vectors version conflict -->

	<runtime>
		<assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">

			<!-- Fix System.Numerics.Vectors -->
			<dependentAssembly>
				<assemblyIdentity
					name="System.Numerics.Vectors"
					publicKeyToken="b03f5f7f11d50a3a"
					culture="neutral" />

				<bindingRedirect
					oldVersion="0.0.0.0-4.1.6.0"
					newVersion="4.1.6.0" />
			</dependentAssembly>

			<!-- Fix System.Memory -->
			<dependentAssembly>
				<assemblyIdentity
					name="System.Memory"
					publicKeyToken="cc7b13ffcd2ddd51"
					culture="neutral" />

				<bindingRedirect
					oldVersion="0.0.0.0-4.0.1.2"
					newVersion="4.0.1.2" />
			</dependentAssembly>

		</assemblyBinding>
	</runtime>


</configuration>
